# ====================================================
# VIT Placement & Internship Management System - Configuration
# ====================================================

# MongoDB Database Connection String (Atlas Cloud or local)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vit_placement?retryWrites=true&w=majority"

# NextAuth Session Secret Key
NEXTAUTH_SECRET="your-32-character-secret-key-goes-here"

# AI API Keys (Optional - Intelligent Verification Engine has procedural fallbacks)
# GEMINI_API_KEY="your-gemini-key"
# OPENAI_API_KEY="your-openai-key"

# PostgreSQL (Optional - Uncomment and set if using PostgreSQL/Supabase)
# DATABASE_URL="postgresql://postgres:password@host:5432/postgres"
